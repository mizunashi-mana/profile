---
import Layout from '../layouts/Layout.astro';
import GitHubCorner from '../components/GitHubCorner.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
---

<Layout title="水無麻那のホームページ">
  <main class="mb-auto">
    <!--
    The original is available on https://github.com/abhinavs/cookie.
    Copyright (c) 2021 Abhinav Saxena
    Released under the MIT license: https://github.com/abhinavs/cookie/blob/master/LICENSE.md
    -->
    <div class="bg-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="lg:text-center">
          <h2 class="font-heading bg-yellow-100 text-yellow-800 px-4 py-2 rounded-lg md:w-64 md:mx-auto text-xs font-semibold tracking-widest text-black uppercase title-font">
            Who am I?
          </h2>
          <p class="font-heading mt-8 text-3xl leading-8 font-semibold tracking-tight text-gray-900 sm:text-4xl">
            水無麻那 (Mizunashi Mana)
          </p>
          <p class="mt-6 max-w-2xl text-lg text-gray-500 lg:mx-auto">
            プログラマを生業にしているヒト科ヒト属の一生命体。
          </p>
          <p class="mt-4 max-w-2xl text-lg text-gray-500 lg:mx-auto">
            日本語話者 (A Japanese talker)。
          </p>
          <p class="mt-4 max-w-2xl text-lg text-gray-500 lg:mx-auto">
            人の作るものが好き。
          </p>
        </div>

        <div class="lg:text-center">
          <ul class="flex justify-center mt-4 max-w-2xl py-2 lg:flex-row lg:mx-auto list-none">
            <li class="flex items-center p-2 hover-parent">
              <a
                class="lg:text-white text-white px-3 py-2 flex items-center text-xs font-bold rounded-full bg-blue-400 hover-child-animate-bounce"
                href="mailto:contact@mizunashi.work"
                rel="me"
                target="_blank"
                >
                <i class="fa-solid fa-envelope text-3xl"></i>
              </a>
            </li>
            <li class="flex items-center p-2 hover-parent">
              <a
                class="lg:text-white text-white px-3 py-2 flex items-center text-xs font-bold rounded-full bg-gray-900 hover-child-animate-bounce"
                href="https://github.com/mizunashi-mana"
                rel="me"
                target="_blank"
                >
                <i class="fa-brands fa-github text-3xl"></i>
              </a>
            </li>
            <li class="flex items-center p-2 hover-parent">
              <a
                class="lg:text-white text-white px-3 py-2 flex items-center text-xs font-bold rounded-full bg-yellow-500 hover-child-animate-bounce"
                href="https://ff.mizunashi.work/@me"
                rel="me"
                target="_blank"
                >
                <i class="fa-solid fa-comment text-3xl"></i>
              </a>
            </li>
            <li class="flex items-center px-2 hover-parent">
              <a
                class="lg:text-white text-white px-3 py-2 flex items-center text-xs font-bold rounded-full bg-indigo-500 hover-child-animate-bounce"
                href="https://social.vivaldi.net/@mizunashi"
                rel="me"
                target="_blank"
                >
                <i class="fa-brands fa-mastodon text-3xl"></i>
              </a>
            </li>
          </ul>
        </div>

        <div class="mt-8">
          <dl class="max-w-3xl mx-auto space-y-10 md:space-y-0 md:grid md:grid-cols-2 md:gap-x-8 md:gap-y-10">
            <div class="relative">
              <dt>
                <a href="https://mizunashi-mana.github.io/blog/" target="_blank">
                  <div class="absolute flex items-center justify-center h-12 w-12 rounded-md bg-yellow-600 text-white">
                    <i class="fa-solid fa-book text-3xl"></i>
                  </div>
                  <p class="font-heading ml-16 text-lg leading-6 font-bold text-gray-700 hover:underline">
                    続くといいな日記
                  </p>
                </a>
              </dt>
              <dd class="mt-2 ml-16 text-base text-gray-500">
                GitHub Pages を使った個人ブログ。更新頻度は低めで、技術紹介がメイン。適当なことを徒然なるままに書いている。
              </dd>
            </div>

            <div class="relative">
              <dt>
                <a href="/recruit" target="_blank">
                  <div class="absolute flex items-center justify-center h-12 w-12 rounded-md bg-green-500 text-white">
                    <i class="fa-solid fa-magnifying-glass text-3xl"></i>
                  </div>
                  <p class="font-heading ml-16 text-lg leading-6 font-bold text-gray-700 hover:underline">
                    職務経歴書
                  </p>
                </a>
              </dt>
              <dd class="mt-2 ml-16 text-base text-gray-500">
                リクルータの方向けの職歴、技能、興味・関心などをまとめたページ。
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </main>

  <GitHubCorner href="https://github.com/mizunashi-mana/profile" />

  <script type="application/ld+json">
    {
      "@context" : "http://schema.org",
      "@type" : "WebSite",
      "name": "水無麻那のホームページ",
      "author": "Mizunashi Mana",
      "description": "水無麻那 (Mizunashi Mana) の自己紹介・ポータルサイト",
      "url" : "https://mizunashi-mana.github.io/"
    }
  </script>

  <GoogleAnalytics measurementId="G-YZTJG0VBE4" />
</Layout>

<style>
  .hover-parent:hover .hover-child-animate-bounce {
    @apply animate-bounce;
  }
</style>
